{
  // Typechecks the replay stage on its own, in seconds:
  //   npx tsc -p scripts/replay-stage/tsconfig.json
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": "../..",
    "paths": { "~/*": ["./*"] }
  },
  "include": ["./**/*.ts", "../../utilities/replayStage/**/*.ts"]
}
